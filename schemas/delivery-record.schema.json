{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-ops.local/schemas/delivery-record.schema.json",
  "title": "PPT-Ops delivery record",
  "description": "One real delivery exported from the HTML presenter view (`E` / Export record). Times are on the presenter talk clock: paused time is excluded and blackout time counts towards the page on screen. Import with `pptops delivery-retro <project-dir> --record <file>`.",
  "type": "object",
  "required": ["kind", "schema_version", "deck", "delivery", "pages", "marks"],
  "properties": {
    "kind": { "const": "delivery_record" },
    "schema_version": { "const": "1.0" },
    "generator": { "type": "string", "minLength": 1 },
    "deck": {
      "type": "object",
      "required": ["id", "project", "title", "page_count"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Presenter sync deck id." },
        "project": { "type": ["string", "null"], "minLength": 1, "description": "Project name; a mismatch is refused on import." },
        "title": { "type": "string", "minLength": 1 },
        "page_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": ["date", "venue", "started_at", "exported_at", "timing_basis", "total_seconds"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "venue": { "type": "string", "enum": ["offline", "online"] },
        "label": { "type": "string", "maxLength": 120 },
        "started_at": { "type": "string", "format": "date-time" },
        "exported_at": { "type": "string", "format": "date-time" },
        "timing_basis": { "const": "talk_clock_excluding_pauses" },
        "total_seconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "description": "Every deck page in deck order, including pages never shown (empty visits).",
      "items": {
        "type": "object",
        "required": ["page", "title", "actual_seconds", "visits"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "PageSpec id when the deck was built from a V1 project; preferred for matching." },
          "title": { "type": "string", "minLength": 1 },
          "estimated_seconds": { "type": "integer", "minimum": 1 },
          "actual_seconds": { "type": "number", "minimum": 0, "description": "Sum of visit durations." },
          "visits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["enter_seconds", "leave_seconds", "entered_at", "left_at"],
              "properties": {
                "enter_seconds": { "type": "number", "minimum": 0 },
                "leave_seconds": { "type": "number", "minimum": 0 },
                "entered_at": { "type": "string", "format": "date-time" },
                "left_at": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "kind", "at_seconds", "marked_at"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "kind": { "type": "string", "enum": ["stumble", "question", "skipped"], "description": "stumble = `!` hard to deliver; question = `?` audience question; skipped = `X`." },
          "at_seconds": { "type": "number", "minimum": 0 },
          "marked_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
